rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.status == "active";
    }

    function canUseFamilyData(familyId) {
      return isFamilyMember(familyId) && (isFamilyOwner(familyId)
        || (exists(/databases/$(database)/documents/families/$(familyId)/services/access)
          && get(/databases/$(database)/documents/families/$(familyId)/services/access).data.get('features', {}).get('familySharing', false)));
    }

    function isFamilyOwner(familyId) {
      return isFamilyMember(familyId)
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == "owner";
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;

      match /app/{docId} {
        allow read, write: if false;
      }

      match /settings/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      match /devices/{deviceId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /families/{familyId} {
      match /services/{serviceId} {
        allow read: if isFamilyMember(familyId) && serviceId == 'access';
        allow write: if false;
      }
      allow read: if isFamilyMember(familyId);
      allow create, delete: if false;
      allow update: if isFamilyOwner(familyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "updatedAt"]);

      match /members/{uid} {
        allow read: if isFamilyMember(familyId);
        allow create, delete: if false;
        allow update: if isFamilyMember(familyId)
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["nickname", "relationship", "profileCompleted", "updatedAt"]);
      }

      match /app/{docId} {
        allow read: if canUseFamilyData(familyId);
        allow create: if canUseFamilyData(familyId) && docId == "state"
          && request.resource.data.get('migrationState', '') != 'copying';
        allow update: if canUseFamilyData(familyId) && docId == "state"
          && resource.data.get('migrationState', '') != 'copying'
          && request.resource.data.get('migrationState', '') == resource.data.get('migrationState', '')
          && request.resource.data.get('schemaVersion', 1) == resource.data.get('schemaVersion', 1)
          && (resource.data.get('schemaVersion', 1) != 2 || !('events' in request.resource.data.app));
        allow delete: if false;
      }

      match /events/{eventId} {
        function storageReady() {
          let state = getAfter(/databases/$(database)/documents/families/$(familyId)/app/state).data;
          return state.get('schemaVersion', 1) == 2 && state.get('migrationState', '') != 'copying';
        }
        function validEvent() {
          let event = request.resource.data;
          return event.keys().hasAll(['id', 'babyId', 'type', 'timestamp'])
            && event.id == eventId
            && event.babyId in ['A', 'B']
            && event.type in ['milk', 'solidFood', 'diaper', 'sleepStart', 'wake', 'daily', 'temperature', 'weight', 'height']
            && event.timestamp is number && event.timestamp >= 0
            && (!('note' in event) || (event.note is string && event.note.size() <= 20000));
        }
        allow read: if canUseFamilyData(familyId);
        allow create, update: if canUseFamilyData(familyId) && storageReady() && validEvent();
        allow delete: if canUseFamilyData(familyId) && storageReady();
      }

      match /mutations/{mutationId} {
        allow read: if canUseFamilyData(familyId);
        allow create: if canUseFamilyData(familyId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'settings', 'consumption', 'createdAt']);
        allow update, delete: if false;
      }
    }

    match /familyInvites/{tokenHash} {
      allow read, write: if false;
    }

    match /wearPairingTokens/{tokenHash} {
      allow read: if false;
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
